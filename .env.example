# AudGen / Presence Labs Audit Generator — environment template
# Copy this file to `.env` and fill in real values for local development.
# Never commit `.env`. Production secrets live in Netlify / your secret manager.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Use postgres locally for parity with production. Sqlite is no longer supported
# by schema.prisma. Example local URL (Docker / local Postgres):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/audgen?schema=public"
NODE_ENV="development"

# Public app origin. Used by metadata, audit signed links, and Stripe redirects.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: book-a-call CTA on audit pages.
# NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-handle/intro"

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Set to "true" to gate /(internal) routes behind a session. Defaults to off
# for local dev so you can hit pages without logging in.
APP_AUTH_ENABLED="false"
# Min 24 chars; required in production when auth is enabled.
SESSION_SECRET="change-me-to-a-long-random-string-min-24-chars"
BETTER_AUTH_SECRET="change-me-to-a-long-random-string-min-24-chars"

# Role-based dev passwords (optional, only used by legacy auth fallback).
# AUTH_OWNER_PASSWORD=""
# AUTH_ADMIN_PASSWORD=""
# AUTH_MEMBER_PASSWORD=""
# AUTH_SALES_PASSWORD=""
# AUTH_VIEWER_PASSWORD=""

# Comma-separated emails granted admin access to /admin and /admin/health.
# ADMIN_EMAILS="you@example.com"

# ---------------------------------------------------------------------------
# Workspaces / tenancy
# ---------------------------------------------------------------------------
DEFAULT_WORKSPACE_SLUG="default"
DEFAULT_WORKSPACE_NAME="Default Workspace"
# Set to "true" only during legacy data migration. Leave unset in prod.
# ALLOW_WORKSPACE_NULL_FALLBACK="false"

# ---------------------------------------------------------------------------
# Audit sharing (signed public links)
# ---------------------------------------------------------------------------
# Min 24 chars; required in production.
AUDIT_LINK_SECRET="change-me-to-a-long-random-string-min-24-chars"
# Default 7 days. Override in seconds.
# AUDIT_LINK_TTL_SECONDS="604800"

# ---------------------------------------------------------------------------
# AI providers (audit + outreach generation)
# Leave empty to use deterministic local fallback generation.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-5"
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-pro"

# ---------------------------------------------------------------------------
# Stripe (billing + SaaS subscriptions)
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_SAAS_PRICE_STARTER=""
# STRIPE_SAAS_PRICE_GROWTH=""
# STRIPE_SAAS_PRICE_AGENCY=""
# STRIPE_SAAS_PRICE_ENTERPRISE=""
# STRIPE_SAAS_TRIAL_DAYS="14"

# ---------------------------------------------------------------------------
# Outbound communication providers (optional)
# ---------------------------------------------------------------------------
# Email
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="hello@yourdomain.com"
# POSTMARK_API_KEY=""
# POSTMARK_FROM_EMAIL="hello@yourdomain.com"
# SMS / calls
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_PHONE="+15555555555"

# ---------------------------------------------------------------------------
# Automation runner protection
# ---------------------------------------------------------------------------
# Required header secret for POST /api/automation/process in production.
# AUTOMATION_RUNNER_SECRET=""

# ---------------------------------------------------------------------------
# Inbound webhook secrets (rotate periodically)
# ---------------------------------------------------------------------------
# COMMUNICATION_WEBHOOK_SECRET=""
# CRM_WEBHOOK_URL=""
# CRM_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Public lead ingest (presencelabs.net → AudGen)
# ---------------------------------------------------------------------------
# PUBLIC_INGEST_API_KEY=""
# PUBLIC_INGEST_API_SECRET=""

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# SENTRY_DSN=""
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
# Logger verbosity filter: info (default) | warn | error | silent.
# LOG_LEVEL="info"
